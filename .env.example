# ---------------------------------------------------------------------------
# PM3 Trading Command Center — environment configuration
# Copy this file to .env.local for local development.
# ---------------------------------------------------------------------------

# Public site URL — used for SEO metadata, OpenGraph tags, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email provider
# The signup form works end-to-end without these — submissions are accepted
# and logged, but no subscriber is created upstream until keys are supplied.
# Set EMAIL_PROVIDER to "convertkit" or "mailerlite" to select the adapter.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=convertkit

# --- ConvertKit ---
# https://app.convertkit.com/account_settings/advanced_settings
CONVERTKIT_API_KEY=
# The Form ID subscribers should be added to.
CONVERTKIT_FORM_ID=

# --- MailerLite ---
# https://dashboard.mailerlite.com/integrations/api
MAILERLITE_API_KEY=
# The Group ID subscribers should be added to.
MAILERLITE_GROUP_ID=
